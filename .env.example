# Copy to .env and fill in (.env is gitignored). Only needed for filler / repeat removal.
# kvm also reads ~/.config/kvm/.env and the GEMINI_API_KEY environment variable.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-3.5-transcribe)
# GEMINI_MODEL=

# Optional: Automatic AI review on filler/repeat removal (default: on). Set to off to disable.
# KVM_AI_REVIEW=on

# Optional: Keep pack outputs in their own subdirectory (default: on). Set to off to write flat.
# KVM_PACK_DIR=on
